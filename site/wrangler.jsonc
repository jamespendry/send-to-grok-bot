// sendtogrokbot.com as Cloudflare Workers static assets. No Worker code runs.
// Deploy from this folder: npx wrangler deploy
// The relay is a separate Worker at relay.sendtogrokbot.com (see relay/).
{
  "name": "sendtogrokbot-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "sendtogrokbot.com", "custom_domain": true },
    { "pattern": "www.sendtogrokbot.com", "custom_domain": true }
  ]
}
