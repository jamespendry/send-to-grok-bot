{
  "manifest_version": 3,
  "name": "Send to Grok Bot",
  "version": "1.1.0",
  "description": "Adds a native-looking button to X posts that sends the post to Grok Bot, Claude, ChatGPT, or Codex.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["logos.js", "content.js"],
      "css": ["content.css"],
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Send to Grok Bot settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
